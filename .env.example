# ==========================================
# MW Technology — Jojo Mendes Configurações
# ==========================================

# 1. Banco de Dados PostgreSQL (Local via Docker ou Supabase em Produção)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jojomendes?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/jojomendes?schema=public"

# 2. Autenticação Administrativa (JWT & Sessão)
# Gere uma chave segura ou use uma string aleatória em desenvolvimento
JWT_SECRET="jojo_mendes_super_secret_jwt_key_mw_tech_2026"
ADMIN_DEFAULT_EMAIL="admin@jojomendes.com.br"
ADMIN_DEFAULT_PASSWORD="admin_jojo_2026!"

# 3. Supabase Storage (Opcional — caso utilize nuvem para fotos em vez de disco local)
# NEXT_PUBLIC_SUPABASE_URL="https://sua-instancia.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# 4. Destino de solicitações de contratação (/api/contratacao)
# Sem estas variáveis definidas, a API responde HTTP 503 (NOT_CONFIGURED) e o formulário exibe modo de demonstração honesto.
# Opção 1: Webhook HTTP (POST JSON)
BOOKING_WEBHOOK_URL=

# Opção 2: Envio via Resend API
RESEND_API_KEY=
BOOKING_RECIPIENT_EMAIL=
BOOKING_FROM_EMAIL="Site Jojo Mendes <contato@seudominio.com.br>"
